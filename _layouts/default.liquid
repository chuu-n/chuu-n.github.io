<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    {% include head.liquid %}

    <!-- Basic SEO -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta name="description" content="{{ page.description | default: site.description }}">
    <meta name="author" content="Chuu">

    <link rel="canonical" href="{{ page.url | absolute_url }}">

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="Gj6_3TYPvSEeSfaV2P0Mr9wD_zz1lU6CO8jqLe7uCAk">

    <!-- Structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Chuu",
      "url": "https://chuu-n.github.io",
      "sameAs": [
        "https://github.com/chuu-n"
      ],
      "jobTitle": "Neuroscience Researcher",
      "affiliation": {
        "@type": "Organization",
        "name": "University of Texas at Austin"
      },
      "knowsAbout": [
        "Cognitive Development",
        "Educational Neuroscience",
        "Developmental Psychology",
        "EEG"
      ]
    }
    </script>
  </head>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    {% include header.liquid %}

    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <div class="col-sm-9">{{ content }}</div>
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    {% include footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
